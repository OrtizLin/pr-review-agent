# Copy to .env (never commit .env or real keys).
# LLM_API_KEY=
# LLM_MODEL=

# Embedding retrieval is the default when a key is set, TF-IDF is
# the offline fallback with no key. Set RETRIEVER=tfidf to force
# TF-IDF, or RETRIEVER=embedding to force embedding. Set base URL
# and model together; EMBEDDING_API_KEY falls back to LLM_API_KEY
# if unset.
# OpenAI preset:
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# Gemini preset (same AI Studio key as the chat path, as Bearer):
# EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# EMBEDDING_MODEL=gemini-embedding-001
# (text-embedding-004 returns HTTP 404 on the v1beta OpenAI-compatible path; do not use it.)
# EMBEDDING_API_KEY=
# RETRIEVER=tfidf
